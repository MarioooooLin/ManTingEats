@model ManTingEats.Models.Commands.ResetPasswordCommand
@{
    ViewData["Title"] = "重設密碼";
}

<div class="page-header">
    <h1>重設密碼</h1>
    <p class="text-muted mb-0">帳號：@ViewData["Username"]</p>
</div>

<div class="row">
    <div class="col-md-5">
        <div class="card">
            <div class="card-body">
                <form asp-action="ResetPassword" asp-route-id="@ViewContext.RouteData.Values["id"]" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label"></label>
                        <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" autofocus />
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ConfirmNewPassword" class="form-label"></label>
                        <input asp-for="ConfirmNewPassword" type="password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                    </div>
                    <div class="small text-muted mb-3">ℹ️ 重設後，此帳號已登入的裝置會被登出，需用新密碼重新登入。</div>
                    <button type="submit" class="btn btn-primary">儲存</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">取消</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
