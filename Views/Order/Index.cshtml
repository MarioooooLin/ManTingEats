@model List<ManTingEats.Models.Entities.Order>
@{
    ViewData["Title"] = "訂單";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h1 class="mb-0">訂單</h1>
    <a asp-action="Create" class="btn btn-primary">+ 新增訂單</a>
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">尚無訂單。</p>
}
else
{
    <div class="card">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>編號</th>
                    <th>通路</th>
                    <th>桌號</th>
                    <th>狀態</th>
                    <th class="text-end">總金額</th>
                    <th>建立時間</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    var badgeClass = order.Status switch
                    {
                        OrderStatus.Open => "bg-warning text-dark",
                        OrderStatus.Completed => "bg-success",
                        OrderStatus.Voided => "bg-secondary",
                        _ => "bg-secondary"
                    };
                    <tr>
                        <td>#@order.Id</td>
                        <td>@order.Channel.ToDisplayText()</td>
                        <td>@(order.TableNumber ?? "-")</td>
                        <td><span class="badge @badgeClass">@order.Status.ToDisplayText()</span></td>
                        <td class="text-end">$@order.TotalAmount.ToString("F2")</td>
                        <td>@order.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary">查看</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
