@model ManTingEats.Models.OrderDetailsViewModel
@{
    var order = Model.Order;
    ViewData["Title"] = $"訂單 #{order.DailyNumber}";
    var badgeClass = order.Status switch
    {
        OrderStatus.Open => "badge-soft-warning",
        OrderStatus.Completed => "badge-soft-success",
        OrderStatus.Voided => "badge-soft-secondary",
        _ => "badge-soft-secondary"
    };
    var channelBadgeClass = order.Channel == OrderChannel.DineIn ? "badge-soft-primary" : "badge-soft-info";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h1 class="mb-0">訂單 #@order.DailyNumber</h1>
    <span class="badge @badgeClass fs-6">@order.Status.ToDisplayText()</span>
</div>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-2">通路</dt>
            <dd class="col-sm-4"><span class="badge @channelBadgeClass">@order.Channel.ToDisplayText()</span></dd>
            <dt class="col-sm-2">桌號</dt>
            <dd class="col-sm-4">@(order.TableNumber ?? "-")</dd>
            <dt class="col-sm-2">總金額</dt>
            <dd class="col-sm-4 fs-5 fw-bold">$@order.TotalAmount.ToString("F0")</dd>
            @if (order.DiscountAmount > 0)
            {
                @* 折扣（v8）：總金額維持原價，另列折扣與實收 *@
                <dt class="col-sm-2">折扣</dt>
                <dd class="col-sm-4 text-danger">
                    −$@order.DiscountAmount.ToString("F0")
                    <div class="small text-muted">
                        @order.DiscountReason?.ToDisplayText()@(string.IsNullOrEmpty(order.DiscountNote) ? "" : "：" + order.DiscountNote)（操作者：@order.DiscountedByEmployee?.Username）
                    </div>
                </dd>
                <dt class="col-sm-2">實收</dt>
                <dd class="col-sm-4 fs-5 fw-bold">$@order.AmountDue.ToString("F0")</dd>
            }
            @if (order.Status == OrderStatus.Voided)
            {
                <dt class="col-sm-2">作廢原因</dt>
                <dd class="col-sm-10 text-danger">@order.VoidReason（操作者：@order.VoidedByEmployee?.Username）</dd>
            }
        </dl>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">品項清單</div>
    <div class="table-responsive">
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th>品項</th>
                <th class="text-end">單價</th>
                <th class="text-end">數量</th>
                <th class="text-end">小計</th>
                <th>出單狀態</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (order.Items.Count == 0)
            {
                <tr><td colspan="6" class="text-muted text-center py-3">尚未加點任何品項</td></tr>
            }
            @foreach (var item in order.Items)
            {
                <tr>
                    <td>
                        @item.MenuItem?.Name
                        @if (item.SpiceLevel is not null)
                        {
                            <div class="text-muted small">辣度：@item.SpiceLevel</div>
                        }
                        @if (item.AddOns.Count > 0)
                        {
                            @* 加料數量為每份的量（v10），多份時標示「每份」避免誤會成整行合計 *@
                            <div class="text-muted small">@(item.Quantity > 1 ? "加料（每份）" : "加料")：@string.Join("、", item.AddOns.Select(a => $"{a.AddOnName} x{a.Quantity}"))</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.Note))
                        {
                            <div class="text-muted small">備註：@item.Note</div>
                        }
                    </td>
                    <td class="text-end">$@item.UnitPrice.ToString("F0")</td>
                    <td class="text-end">@item.Quantity</td>
                    <td class="text-end">$@item.Subtotal.ToString("F0")</td>
                    <td>
                        @if (item.IsPrinted)
                        {
                            <span class="badge badge-soft-secondary">已出單</span>
                        }
                        else
                        {
                            <span class="badge badge-soft-warning">待出單</span>
                        }
                    </td>
                    <td class="text-end">
                        @if (order.Status == OrderStatus.Open)
                        {
                            <form asp-action="RemoveItem" method="post" class="d-inline" onsubmit="return confirm('確定要移除此品項？');">
                                <input type="hidden" name="orderId" value="@order.Id" />
                                <input type="hidden" name="orderItemId" value="@item.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">移除</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</div>

@if (order.Status == OrderStatus.Open)
{
    var isFirstOrder = order.Items.Count == 0;
    var pendingCount = order.Items.Count(i => !i.IsPrinted);
    <div class="card mb-4">
        <div class="card-header">@(isFirstOrder ? "點餐" : "加點")</div>
        <div class="card-body">
            @if (Model.ActiveMenuItems.Count == 0)
            {
                <p class="text-muted mb-0">目前沒有上架中的菜單品項，請先至菜單管理新增。</p>
            }
            else
            {
                var categories = Model.ActiveMenuItems.GroupBy(m => m.Category).OrderBy(g => g.Key);
                <ul class="nav nav-pills mb-3">
                    @{ var isFirstCategory = true; }
                    @foreach (var group in categories)
                    {
                        <li class="nav-item">
                            <button class="nav-link @(isFirstCategory ? "active" : "")" data-bs-toggle="pill" data-bs-target="#cat-@group.Key" type="button">
                                @group.Key.ToDisplayText()
                            </button>
                        </li>
                        isFirstCategory = false;
                    }
                </ul>

                <div class="tab-content mb-3">
                    @{ isFirstCategory = true; }
                    @foreach (var group in categories)
                    {
                        <div class="tab-pane fade @(isFirstCategory ? "show active" : "")" id="cat-@group.Key">
                            <div class="row row-cols-2 row-cols-md-4 g-2">
                                @foreach (var menuItem in group)
                                {
                                    var isCustomized = menuItem.SupportsAddOns || menuItem.SupportsSpiceLevel;
                                    <div class="col" data-menu-item-id="@menuItem.Id">
                                        <button type="button" class="btn btn-outline-primary w-100 py-3 position-relative menu-item-card"
                                                data-id="@menuItem.Id" data-name="@menuItem.Name" data-price="@menuItem.Price.ToString("F0")"
                                                data-supports-addons="@menuItem.SupportsAddOns.ToString().ToLowerInvariant()"
                                                data-supports-spice="@menuItem.SupportsSpiceLevel.ToString().ToLowerInvariant()">
                                            <div class="fw-bold">@menuItem.Name</div>
                                            <div class="small text-muted">$@menuItem.Price.ToString("F0")</div>
                                            @if (isCustomized)
                                            {
                                                <div class="small text-primary">可客製化</div>
                                                @* 客製化品項可能有多列不同設定，卡片只顯示清單中的總份數，調整在下方清單 *@
                                                <span class="badge rounded-pill bg-danger position-absolute top-0 end-0 m-1 fs-6 menu-item-badge" hidden></span>
                                            }
                                        </button>
                                        @if (!isCustomized)
                                        {
                                            @* 一般品項（v14）：點卡片 +1，份數直接在卡片上調整，即為清單中的份數 *@
                                            <div class="qty-stepper menu-item-stepper mt-1" hidden>
                                                <button type="button" class="btn btn-outline-secondary qty-btn cart-step" data-step="-1">−</button>
                                                <span class="form-control text-center menu-item-qty"></span>
                                                <button type="button" class="btn btn-outline-secondary qty-btn cart-step" data-step="1">+</button>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                        isFirstCategory = false;
                    }
                </div>

                @* 本次點餐清單（v14）：只存在瀏覽器，按「送出」才一次寫入；內容由下方腳本產生 *@
                <div id="cartSection" hidden>
                    <h6 class="fw-bold">本次點餐（尚未送出）</h6>
                    <div id="cartList" class="list-group mb-2"></div>
                    <div id="cartLimitWarning" class="text-danger small mb-2" hidden></div>
                    <form asp-action="AddItems" method="post" id="cartForm"
                          data-pending-count="@pendingCount" data-max-pending="@ManTingEats.Models.Commands.OrderLimits.MaxPendingItems"
                          data-max-quantity="@ManTingEats.Models.Commands.OrderLimits.MaxQuantity"
                          data-submit-label="@(Model.IsPhone ? "送出" : "送出並出單")">
                        <input type="hidden" name="orderId" value="@order.Id" />
                        <button type="submit" class="btn btn-primary btn-lg w-100" id="cartSubmit">送出</button>
                    </form>
                </div>

                <div class="offcanvas offcanvas-bottom" tabindex="-1" id="customizeItemPanel" style="height: auto; max-height: 85vh;">
                    <div class="offcanvas-header">
                        <h5 class="offcanvas-title" id="customizeItemName"></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
                    </div>
                    <div class="offcanvas-body d-flex flex-column">
                        @* 只把設定加入本次點餐清單（v14），不直接送到伺服器 *@
                        <form id="customizeForm" class="d-flex flex-column flex-grow-1">
                            <input type="hidden" id="customizeMenuItemId" />

                            <div class="flex-grow-1" style="overflow-y: auto;">
                                @* 客製化品項可點多份（v10），辣度、加料、備註套用到每一份；設定不同時分成清單中的不同列 *@
                                <div class="mb-3">
                                    <label class="form-label">份數</label>
                                    <div class="qty-stepper">
                                        <button type="button" class="btn btn-outline-secondary qty-btn" data-step="-1">−</button>
                                        <input type="number" name="Quantity" id="customizeQuantity" value="1" min="1" max="@ManTingEats.Models.Commands.OrderLimits.MaxQuantity" step="1" required class="form-control" />
                                        <button type="button" class="btn btn-outline-secondary qty-btn" data-step="1">+</button>
                                    </div>
                                    <div class="form-text">以下辣度、加料、備註會套用到每一份；加料數量為每份的量。</div>
                                </div>

                                <div class="mb-3" id="spiceSection">
                                    <label class="form-label">辣度</label>
                                    <div class="btn-group w-100 spice-btn-group" role="group">
                                        @for (var level = ManTingEats.Models.Commands.OrderLimits.MinSpiceLevel; level <= ManTingEats.Models.Commands.OrderLimits.MaxSpiceLevel; level++)
                                        {
                                            var inputId = $"spice-{level}";
                                            <input type="radio" class="btn-check" name="SpiceLevel" id="@inputId" value="@level" autocomplete="off" @(level == ManTingEats.Models.Commands.OrderLimits.DefaultSpiceLevel ? "checked" : "") />
                                            <label class="btn btn-outline-secondary spice-btn" for="@inputId">@level</label>
                                        }
                                    </div>
                                </div>

                                <div class="mb-3" id="addOnsSection">
                                    <label class="form-label">加料</label>
                                    <div style="max-height: 240px; overflow-y: auto;">
                                        @foreach (var addOn in Model.ActiveAddOns)
                                        {
                                            <div class="d-flex align-items-center justify-content-between addon-row">
                                                <div class="form-check mb-0">
                                                    <input type="checkbox" class="form-check-input addon-checkbox" id="addon-@addOn.Id"
                                                           data-addon-id="@addOn.Id" data-addon-name="@addOn.Name" data-addon-price="@addOn.Price.ToString("F0")" />
                                                    <label class="form-check-label stretched-label" for="addon-@addOn.Id">@addOn.Name <span class="text-muted">+$@addOn.Price.ToString("F0")</span></label>
                                                </div>
                                                <div class="qty-stepper addon-qty-stepper" style="display: none;">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary qty-btn" data-step="-1">−</button>
                                                    <input type="number" class="form-control form-control-sm addon-qty-input" value="1" min="1" max="@ManTingEats.Models.Commands.OrderLimits.MaxQuantity" step="1" style="width: 3.5rem;" />
                                                    <button type="button" class="btn btn-sm btn-outline-secondary qty-btn" data-step="1">+</button>
                                                </div>
                                            </div>
                                        }
                                        @if (Model.ActiveAddOns.Count == 0)
                                        {
                                            <p class="text-muted small mb-0">尚無可選加料。</p>
                                        }
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">備註（選填）</label>
                                    <input type="text" name="Note" maxlength="100" class="form-control" />
                                </div>
                            </div>

                            <div class="offcanvas-sticky-footer">
                                <div>
                                    <div class="text-muted small">小計</div>
                                    <div class="fs-4 fw-bold text-brand">$<span id="customizeSubtotal">0</span></div>
                                </div>
                                <button type="submit" class="btn btn-primary btn-lg flex-grow-1">加入清單</button>
                            </div>
                        </form>
                    </div>
                </div>
            }
            @{
                var hasPrintedItems = order.Items.Any(i => i.IsPrinted);
            }
            @if (pendingCount > 0 || !hasPrintedItems)
            {
                <div class="mt-3">
                    @if (pendingCount > 0 && Model.IsPhone)
                    {
                        @* 手機不接印表機（v14），不顯示「確認訂單」以免出單失敗，改提示到 iPad 出單 *@
                        <div class="alert alert-warning py-2 mb-2">尚有 @pendingCount 項待出單，請到 iPad 按「確認訂單」出單。</div>
                    }
                    else if (pendingCount > 0)
                    {
                        @* 送出即出單（v14）後，此按鈕用於出單失敗（印表機未連線、缺紙等）時重新出單，或手機點餐後在 iPad 出單 *@
                        <form asp-action="ConfirmPrint" method="post" class="d-inline" id="confirmPrintForm"
                              data-auto-print="@((TempData["AutoPrint"] is true).ToString().ToLowerInvariant())">
                            <input type="hidden" name="orderId" value="@order.Id" />
                            <button type="submit" class="btn btn-primary">確認訂單（@pendingCount 項）</button>
                        </form>
                    }
                    @if (!hasPrintedItems)
                    {
                        @* 未成立（從未出單）的訂單取消即刪除（v15），不留單號、不進訂單列表 *@
                        <form asp-action="CancelPendingItems" method="post" class="d-inline" onsubmit="return confirm('確定要取消此訂單？訂單會直接刪除，不會留下紀錄。');">
                            <input type="hidden" name="orderId" value="@order.Id" />
                            <button type="submit" class="btn btn-outline-danger">取消</button>
                        </form>
                    }
                </div>
            }
        </div>
    </div>

    @* 結帳不補印（v5）：仍有待出單品項時先擋下，提示先出單；後端 Checkout 也會再檢查一次 *@
    var unprintedCount = order.Items.Count(i => !i.IsPrinted);
    var totalText = order.TotalAmount.ToString("F0");
    <div class="mb-4">
        @* 結帳視窗本身就是確認步驟，取代原本的 confirm 對話框 *@
        <button type="button" class="btn btn-success btn-lg" data-bs-toggle="modal" data-bs-target="#checkoutModal" @(order.Items.Count == 0 || unprintedCount > 0 ? "disabled" : "")>結帳（應收 $@order.TotalAmount.ToString("F0")）</button>
        @if (unprintedCount > 0)
        {
            <div class="text-muted small mt-1">尚有 @unprintedCount 項未出單，請先確認訂單或移除這些品項。</div>
        }
    </div>

    @* 結帳收款（v6）：必須「收剛好」或輸入收款金額才能結帳；收款金額只用來算找零，不存資料庫 *@
    @* 外帶出單成功後自動打開（v16），由 MarkPrinted 帶 AutoCheckout 標記；讀一次即消失，重新整理不會再跳出 *@
    <div class="modal fade" id="checkoutModal" tabindex="-1" aria-labelledby="checkoutModalTitle" aria-hidden="true"
         data-auto-open="@((TempData["AutoCheckout"] is true && unprintedCount == 0).ToString().ToLowerInvariant())">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="checkoutModalTitle">結帳 — 訂單 #@order.DailyNumber</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="關閉"></button>
                </div>
                <div class="modal-body">
                    @* 單一表單：「收剛好」與「確認結帳」都送出同一份資料，折扣欄位（v8）才能一併帶到後端 *@
                    <form asp-action="Checkout" asp-route-id="@order.Id" method="post" id="checkoutForm" data-total="@totalText">
                        <div class="text-center mb-3">
                            <div class="text-muted">應收</div>
                            <div class="text-muted text-decoration-line-through" id="originalTotal" hidden>$@totalText</div>
                            <div class="display-5 fw-bold text-brand" id="dueDisplay">$@totalText</div>
                            <div class="text-muted small">結帳後將無法再加點</div>
                        </div>

                        <div class="text-center mb-3">
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="btnToggleDiscount">給折扣</button>
                        </div>

                        @* 折扣（v8）：改收金額／打折／抹零都換算成折扣後應收金額，以 discountedAmount 送出；收起時該欄位停用、不送出 *@
                        <div class="border rounded p-3 mb-3" id="discountSection" hidden>
                            <div class="btn-group w-100 mb-2" role="group">
                                <input type="radio" class="btn-check" name="discountMode" id="discountModeAmount" value="amount" checked />
                                <label class="btn btn-outline-secondary" for="discountModeAmount">改收金額</label>
                                <input type="radio" class="btn-check" name="discountMode" id="discountModeRate" value="rate" />
                                <label class="btn btn-outline-secondary" for="discountModeRate">打折</label>
                            </div>
                            <div id="discountAmountGroup" class="mb-2">
                                <input type="number" inputmode="numeric" id="discountFinal" class="form-control form-control-lg" min="0" step="1" placeholder="要收的金額" />
                            </div>
                            <div id="discountRateGroup" class="mb-2" hidden>
                                <input type="number" inputmode="numeric" id="discountRate" class="form-control form-control-lg" min="1" max="99" step="1" placeholder="幾折（9 折輸入 9、85 折輸入 85）" />
                            </div>
                            @if (order.TotalAmount % 10 != 0)
                            {
                                <button type="button" class="btn btn-outline-primary btn-sm mb-2" id="btnRoundOff" data-amount="@ManTingEats.Services.OrderDiscount.RoundOff(order.TotalAmount).ToString("F0")">抹零（收 $@ManTingEats.Services.OrderDiscount.RoundOff(order.TotalAmount).ToString("F0")）</button>
                            }

                            <div class="small text-muted mb-1">折扣原因（必選）</div>
                            <div class="d-flex flex-wrap gap-1 mb-2">
                                @foreach (var reason in Enum.GetValues<DiscountReason>())
                                {
                                    <input type="radio" class="btn-check" name="discountReason" id="reason-@reason" value="@reason" data-requires-note="@ManTingEats.Services.OrderDiscount.RequiresNote(reason).ToString().ToLowerInvariant()" disabled />
                                    <label class="btn btn-sm btn-outline-secondary" for="reason-@reason">@reason.ToDisplayText()</label>
                                }
                            </div>
                            <input type="text" name="discountNote" id="discountNote" class="form-control mb-2" maxlength="@ManTingEats.Services.OrderDiscount.MaxNoteLength" placeholder="說明（餐點問題、其他必填）" disabled />
                            <div id="discountSummary" class="small"></div>
                            <input type="hidden" name="discountedAmount" id="discountedAmount" disabled />
                            <button type="button" class="btn btn-link btn-sm px-0" id="btnCancelDiscount">取消折扣</button>
                        </div>

                        <button type="button" class="btn btn-success btn-lg w-100" id="btnExact">收剛好，直接結帳</button>

                        <hr />

                        <label for="receivedAmount" class="form-label">或輸入收到的金額</label>
                        <div class="d-flex flex-wrap gap-2 mb-2" id="quickAmounts"></div>
                        <input type="number" inputmode="numeric" name="receivedAmount" id="receivedAmount" class="form-control form-control-lg"
                               min="0" max="@ManTingEats.Services.CashPayment.MaxReceivedAmount.ToString("F0")" step="1" placeholder="收到金額" />
                        <div id="changeDisplay" class="fs-3 fw-bold text-center mt-3 text-muted">請選擇或輸入金額</div>
                        <button type="submit" id="btnConfirmCheckout" class="btn btn-primary btn-lg w-100 mt-3" disabled>確認結帳</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@if (order.Status == OrderStatus.Completed || (order.Status == OrderStatus.Open && order.Items.Any(i => i.IsPrinted)))
{
    @* 已成立（出過單）的訂單不論是否結帳，一律稱「作廢」（v15），與未成立訂單的「取消」（直接刪除）區分 *@
    var voidTitle = "作廢訂單";
    var voidConfirmText = "確定要作廢此訂單？此操作將記錄稽核紀錄且無法復原。";
    <div class="card border-danger">
        <div class="card-header text-danger">@voidTitle</div>
        <div class="card-body">
            <form asp-action="Void" asp-route-id="@order.Id" method="post" class="row g-2 align-items-end" onsubmit="return confirm('@voidConfirmText');">
                <div class="col-auto flex-grow-1">
                    <label class="form-label">作廢原因</label>
                    <input type="text" name="Reason" class="form-control" maxlength="200" required />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-danger">@voidTitle</button>
                </div>
            </form>
        </div>
    </div>
}

<a asp-action="Index" class="btn btn-outline-secondary mt-4">回訂單列表</a>

@if (order.Status != OrderStatus.Voided)
{
    <form asp-action="Reprint" asp-route-id="@order.Id" method="post" class="d-inline">
        <button type="submit" class="btn btn-outline-secondary mt-4">補印出單</button>
    </form>
}

@section Scripts {
    <script>
        // 結帳收款（v6）＋折扣（v8）：即時計算折扣後應收與找零；條件不符時停用送出按鈕（後端 Checkout 也會再檢查）
        (function () {
            var form = document.getElementById('checkoutForm');
            if (!form) {
                return;
            }
            var total = parseInt(form.dataset.total, 10);
            var input = document.getElementById('receivedAmount');
            var display = document.getElementById('changeDisplay');
            var confirmButton = document.getElementById('btnConfirmCheckout');
            var exactButton = document.getElementById('btnExact');
            var dueDisplay = document.getElementById('dueDisplay');
            var originalTotal = document.getElementById('originalTotal');
            var section = document.getElementById('discountSection');
            var toggleButton = document.getElementById('btnToggleDiscount');
            var finalInput = document.getElementById('discountFinal');
            var rateInput = document.getElementById('discountRate');
            var noteInput = document.getElementById('discountNote');
            var summary = document.getElementById('discountSummary');
            var discountedAmount = document.getElementById('discountedAmount');
            var reasonInputs = form.querySelectorAll('input[name="discountReason"]');
            var quickContainer = document.getElementById('quickAmounts');

            // 打折：1～9 代表幾折、10～99 代表幾幾折，四捨五入到元（與 OrderDiscount.ApplyRate 相同）
            function applyRate(rate) {
                var percent = rate >= 1 && rate <= 9 ? rate * 10 : (rate >= 10 && rate <= 99 ? rate : 0);
                return percent === 0 ? NaN : Math.round(total * percent / 100);
            }

            // 只接受整數：parseInt 會把 8.5 默默當成 8（85 折變 8 折），因此先檢查格式，小數一律視為錯誤
            function readWhole(el) {
                var raw = el.value.trim();
                if (raw === '' && !el.validity.badInput) {
                    return { empty: true, valid: false, value: NaN };
                }
                var valid = /^\d+$/.test(raw);
                return { empty: false, valid: valid, value: valid ? parseInt(raw, 10) : NaN };
            }

            function mode() {
                return form.querySelector('input[name="discountMode"]:checked').value;
            }

            function selectedReason() {
                return form.querySelector('input[name="discountReason"]:checked');
            }

            // 回傳 { due, error }：未開啟折扣時 due 即原價
            function discountState() {
                if (section.hidden) {
                    return { due: total, error: null };
                }
                var due;
                if (mode() === 'amount') {
                    var amount = readWhole(finalInput);
                    if (amount.empty) {
                        return { due: total, error: '請輸入要收的金額' };
                    }
                    if (!amount.valid) {
                        return { due: total, error: '要收的金額請輸入整數' };
                    }
                    due = amount.value;
                } else {
                    var rate = readWhole(rateInput);
                    if (rate.empty) {
                        return { due: total, error: '請輸入折數' };
                    }
                    if (!rate.valid) {
                        return { due: total, error: '折數請輸入整數（85 折請輸入 85）' };
                    }
                    due = applyRate(rate.value);
                    if (isNaN(due)) {
                        return { due: total, error: '請輸入 1～99 的折數' };
                    }
                }
                if (due < 0 || due >= total) {
                    return { due: total, error: '折扣後金額需介於 0 與原價之間' };
                }
                var reason = selectedReason();
                if (!reason) {
                    return { due: due, error: '請選擇折扣原因' };
                }
                if (reason.dataset.requiresNote === 'true' && noteInput.value.trim() === '') {
                    return { due: due, error: '此原因需填寫說明' };
                }
                return { due: due, error: null };
            }

            // 快速金額：下一個整百、$500、$1000 中大於應收者（與 v6 規則相同，依折扣後應收重新計算）
            function renderQuickAmounts(due) {
                var amounts = [Math.floor(due / 100) * 100 + 100, 500, 1000]
                    .filter(function (a, i, all) { return a > due && all.indexOf(a) === i; })
                    .sort(function (a, b) { return a - b; });
                quickContainer.innerHTML = '';
                amounts.forEach(function (amount) {
                    var btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'btn btn-outline-primary btn-lg flex-fill';
                    btn.textContent = '$' + amount;
                    btn.addEventListener('click', function () {
                        input.value = amount;
                        update();
                    });
                    quickContainer.appendChild(btn);
                });
            }

            var lastDue = null;
            function update() {
                var state = discountState();
                var due = state.due;
                var discountValid = !section.hidden && state.error === null;

                discountedAmount.disabled = !discountValid;
                discountedAmount.value = discountValid ? due : '';
                originalTotal.hidden = !discountValid;
                dueDisplay.textContent = '$' + due;
                if (!section.hidden) {
                    summary.className = 'small ' + (state.error ? 'text-danger' : 'text-success');
                    summary.textContent = state.error
                        ? state.error
                        : '原價 $' + total + ' → 折扣 −$' + (total - due) + ' → 應收 $' + due;
                }
                if (due !== lastDue) {
                    renderQuickAmounts(due);
                    lastDue = due;
                }

                var blocked = !section.hidden && state.error !== null;
                exactButton.disabled = blocked;
                var receivedInput = readWhole(input);
                var received = receivedInput.value;
                if (receivedInput.empty) {
                    display.className = 'fs-3 fw-bold text-center mt-3 text-muted';
                    display.textContent = '請選擇或輸入金額';
                    confirmButton.disabled = true;
                } else if (!receivedInput.valid) {
                    display.className = 'fs-3 fw-bold text-center mt-3 text-danger';
                    display.textContent = '收到金額請輸入整數';
                    confirmButton.disabled = true;
                } else if (received < due) {
                    display.className = 'fs-3 fw-bold text-center mt-3 text-danger';
                    display.textContent = '還差 $' + (due - received);
                    confirmButton.disabled = true;
                } else {
                    display.className = 'fs-3 fw-bold text-center mt-3 text-success';
                    display.textContent = '找零 $' + (received - due);
                    confirmButton.disabled = blocked;
                }
            }

            function setDiscountOpen(open) {
                section.hidden = !open;
                toggleButton.hidden = open;
                // 收起時停用原因與說明欄位，避免沒有折扣卻送出原因
                reasonInputs.forEach(function (r) { r.disabled = !open; if (!open) { r.checked = false; } });
                noteInput.disabled = !open;
                if (!open) {
                    finalInput.value = '';
                    rateInput.value = '';
                    noteInput.value = '';
                    summary.textContent = '';
                }
                update();
            }

            toggleButton.addEventListener('click', function () { setDiscountOpen(true); finalInput.focus(); });
            document.getElementById('btnCancelDiscount').addEventListener('click', function () { setDiscountOpen(false); });
            form.querySelectorAll('input[name="discountMode"]').forEach(function (radio) {
                radio.addEventListener('change', function () {
                    document.getElementById('discountAmountGroup').hidden = mode() !== 'amount';
                    document.getElementById('discountRateGroup').hidden = mode() !== 'rate';
                    update();
                });
            });
            var roundOff = document.getElementById('btnRoundOff');
            if (roundOff) {
                roundOff.addEventListener('click', function () {
                    document.getElementById('discountModeAmount').click();
                    finalInput.value = this.dataset.amount;
                    document.getElementById('reason-RoundOff').checked = true;
                    update();
                });
            }
            [finalInput, rateInput, noteInput, input].forEach(function (el) { el.addEventListener('input', update); });
            reasonInputs.forEach(function (r) { r.addEventListener('change', update); });

            // 收剛好：收款金額等於（折扣後）應收，直接送出
            exactButton.addEventListener('click', function () {
                input.value = discountState().due;
                update();
                if (!exactButton.disabled) {
                    exactButton.disabled = true;
                    confirmButton.disabled = true;
                    form.submit();
                }
            });
            // 防止連點送出兩次：第二次會因訂單已結帳而顯示錯誤，蓋掉含找零的成功訊息
            form.addEventListener('submit', function () {
                confirmButton.disabled = true;
                exactButton.disabled = true;
            });
            // 每次打開結帳視窗都從原價、空白金額開始，避免沿用上次輸入
            var checkoutModal = document.getElementById('checkoutModal');
            checkoutModal.addEventListener('show.bs.modal', function () {
                input.value = '';
                setDiscountOpen(false);
            });
            update();

            // 外帶點完即結帳（v16）：出單成功回到本頁時直接打開結帳視窗；不結帳（例如客人還要加點）關掉即可
            if (checkoutModal.dataset.autoOpen === 'true') {
                bootstrap.Modal.getOrCreateInstance(checkoutModal).show();
            }
        })();

        // ── 整批點餐（v14）：品項先放進「本次點餐」清單，按「送出」才一次寫入 ──
        // 清單只存在這個頁面；點選過程不重新載入，分類分頁與捲動位置都不會跳回
        var cartForm = document.getElementById('cartForm');
        var cart = [];              // 每列：{ menuItemId, name, price, customized, quantity, note, spiceLevel, addOns: [{ id, name, price, qty }] }
        var cartSubmitting = false; // 送出時不再跳「尚未送出」提醒

        function lineSubtotal(line) {
            // 與後端 OrderItem.Subtotal 相同：（品項單價 + 每份加料金額）x 份數
            var perServing = line.price;
            line.addOns.forEach(function (a) { perServing += a.price * a.qty; });
            return perServing * line.quantity;
        }

        function simpleLine(menuItemId) {
            return cart.find(function (l) { return !l.customized && l.menuItemId === menuItemId; });
        }

        function changeQuantity(line, step) {
            var max = parseInt(cartForm.dataset.maxQuantity, 10);
            line.quantity = Math.min(max, line.quantity + step);
            if (line.quantity <= 0) {
                cart.splice(cart.indexOf(line), 1);
            }
            renderCart();
        }

        function createStepButton(text, onClick) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'btn btn-outline-secondary qty-btn';
            btn.textContent = text;
            btn.addEventListener('click', onClick);
            return btn;
        }

        function renderCart() {
            var list = document.getElementById('cartList');
            list.replaceChildren();
            // 品名、加料名稱、備註一律以 textContent 寫入，不會被當成 HTML 解析
            cart.forEach(function (line) {
                var row = document.createElement('div');
                row.className = 'list-group-item cart-line';

                var info = document.createElement('div');
                info.className = 'cart-line-info';
                var name = document.createElement('div');
                name.className = 'fw-bold';
                name.textContent = line.name;
                info.appendChild(name);
                if (line.spiceLevel !== null) {
                    var spice = document.createElement('div');
                    spice.className = 'text-muted small';
                    spice.textContent = '辣度：' + line.spiceLevel;
                    info.appendChild(spice);
                }
                if (line.addOns.length > 0) {
                    var addOns = document.createElement('div');
                    addOns.className = 'text-muted small';
                    addOns.textContent = (line.quantity > 1 ? '加料（每份）：' : '加料：')
                        + line.addOns.map(function (a) { return a.name + ' x' + a.qty; }).join('、');
                    info.appendChild(addOns);
                }
                var note = document.createElement('input');
                note.type = 'text';
                note.maxLength = 100;
                note.placeholder = '備註（選填）';
                note.className = 'form-control form-control-sm mt-1';
                note.value = line.note;
                note.addEventListener('input', function () { line.note = note.value; });
                info.appendChild(note);

                var stepper = document.createElement('div');
                stepper.className = 'qty-stepper';
                var qty = document.createElement('span');
                qty.className = 'form-control text-center';
                qty.textContent = line.quantity;
                stepper.append(
                    createStepButton('−', function () { changeQuantity(line, -1); }),
                    qty,
                    createStepButton('+', function () { changeQuantity(line, 1); }));

                var subtotal = document.createElement('div');
                subtotal.className = 'fw-bold text-end cart-line-subtotal';
                subtotal.textContent = '$' + lineSubtotal(line).toFixed(0);

                var remove = document.createElement('button');
                remove.type = 'button';
                remove.className = 'btn btn-outline-danger';
                remove.setAttribute('aria-label', '從清單移除');
                remove.textContent = '✕';
                remove.addEventListener('click', function () {
                    cart.splice(cart.indexOf(line), 1);
                    renderCart();
                });

                row.append(info, stepper, subtotal, remove);
                list.appendChild(row);
            });

            // 卡片上的份數：一般品項顯示在卡片下方的 −／+，客製化品項以角標顯示總份數
            document.querySelectorAll('[data-menu-item-id]').forEach(function (col) {
                var id = parseInt(col.dataset.menuItemId, 10);
                var total = cart.filter(function (l) { return l.menuItemId === id; })
                    .reduce(function (sum, l) { return sum + l.quantity; }, 0);
                var stepper = col.querySelector('.menu-item-stepper');
                if (stepper) {
                    stepper.hidden = total === 0;
                    stepper.querySelector('.menu-item-qty').textContent = total;
                }
                var badge = col.querySelector('.menu-item-badge');
                if (badge) {
                    badge.hidden = total === 0;
                    badge.textContent = total;
                }
                col.querySelector('.menu-item-card').classList.toggle('in-cart', total > 0);
            });

            // 待出單上限（v14）：已在資料庫待出單的 + 本次清單的列數；後端 AddItems 也會再檢查
            var pending = parseInt(cartForm.dataset.pendingCount, 10);
            var maxPending = parseInt(cartForm.dataset.maxPending, 10);
            var overLimit = pending + cart.length > maxPending;
            var warning = document.getElementById('cartLimitWarning');
            warning.hidden = !overLimit;
            warning.textContent = '待出單最多 ' + maxPending + ' 項（目前 ' + pending + ' 項，本次 ' + cart.length
                + ' 項），請減少品項分批送出；若有待出單品項，請先在 iPad 出單。';

            var total = cart.reduce(function (sum, l) { return sum + lineSubtotal(l); }, 0);
            var submit = document.getElementById('cartSubmit');
            submit.disabled = overLimit;
            submit.textContent = cartForm.dataset.submitLabel + ' ' + cart.length + ' 項（$' + total.toFixed(0) + '）';
            document.getElementById('cartSection').hidden = cart.length === 0;
        }

        document.querySelectorAll('.menu-item-card').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var isCustomized = this.dataset.supportsAddons === 'true' || this.dataset.supportsSpice === 'true';
                if (isCustomized) {
                    document.getElementById('customizeMenuItemId').value = this.dataset.id;
                    document.getElementById('customizeItemName').textContent = this.dataset.name + '（$' + this.dataset.price + '）';
                    document.getElementById('spiceSection').style.display = this.dataset.supportsSpice === 'true' ? '' : 'none';
                    document.getElementById('addOnsSection').style.display = this.dataset.supportsAddons === 'true' ? '' : 'none';

                    var form = document.getElementById('customizeForm');
                    form.querySelectorAll('.addon-checkbox').forEach(function (cb) {
                        cb.checked = false;
                        cb.closest('.addon-row').classList.remove('addon-row-selected');
                        cb.closest('.addon-row').querySelector('.addon-qty-stepper').style.display = 'none';
                        cb.closest('.addon-row').querySelector('.addon-qty-input').value = 1;
                    });
                    var firstSpice = form.querySelector('input[name="SpiceLevel"][value="@ManTingEats.Models.Commands.OrderLimits.DefaultSpiceLevel"]');
                    if (firstSpice) { firstSpice.checked = true; }
                    document.getElementById('customizeQuantity').value = 1;
                    form.elements['Note'].value = '';

                    updateCustomizeSubtotal(parseFloat(this.dataset.price));
                    bootstrap.Offcanvas.getOrCreateInstance(document.getElementById('customizeItemPanel')).show();
                } else {
                    // 一般品項：點一下 = 清單中該品項 +1，不跳面板
                    var id = parseInt(this.dataset.id, 10);
                    var line = simpleLine(id);
                    if (line) {
                        changeQuantity(line, 1);
                    } else {
                        cart.push({
                            menuItemId: id, name: this.dataset.name, price: parseFloat(this.dataset.price),
                            customized: false, quantity: 1, note: '', spiceLevel: null, addOns: []
                        });
                        renderCart();
                    }
                }
            });
        });

        // 一般品項卡片下方的 −／+
        document.querySelectorAll('.menu-item-stepper .cart-step').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var id = parseInt(this.closest('[data-menu-item-id]').dataset.menuItemId, 10);
                var line = simpleLine(id);
                if (line) {
                    changeQuantity(line, parseInt(this.dataset.step, 10));
                }
            });
        });

        // 客製化面板內的份數與加料數量 −／+（卡片與清單的 −／+ 另有處理）
        document.querySelectorAll('#customizeItemPanel .qty-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = this.parentElement.querySelector('input[type="number"]');
                var next = parseInt(input.value || '1', 10) + parseInt(this.dataset.step, 10);
                input.value = Math.min(parseInt(input.max, 10) || 99, Math.max(1, next));
                updateCustomizeSubtotalFromForm();
            });
        });

        document.querySelectorAll('.addon-checkbox').forEach(function (cb) {
            cb.addEventListener('change', function () {
                this.closest('.addon-row').classList.toggle('addon-row-selected', this.checked);
                this.closest('.addon-row').querySelector('.addon-qty-stepper').style.display = this.checked ? '' : 'none';
                updateCustomizeSubtotalFromForm();
            });
        });

        // iPad 上手指容易按在加料列的空白處，因此整列都可切換勾選；
        // 點到 checkbox／文字（label）時瀏覽器本身就會切換，點到數量 +/− 則不應改變勾選，兩者皆略過
        document.querySelectorAll('.addon-row').forEach(function (row) {
            row.addEventListener('click', function (event) {
                if (event.target.closest('.addon-qty-stepper, .addon-checkbox, label')) {
                    return;
                }
                var cb = row.querySelector('.addon-checkbox');
                cb.checked = !cb.checked;
                cb.dispatchEvent(new Event('change'));
            });
        });

        document.querySelectorAll('.addon-qty-input').forEach(function (input) {
            input.addEventListener('input', updateCustomizeSubtotalFromForm);
        });
        var customizeQuantityInput = document.getElementById('customizeQuantity');
        if (customizeQuantityInput) customizeQuantityInput.addEventListener('input', updateCustomizeSubtotalFromForm);

        function updateCustomizeSubtotalFromForm() {
            var priceText = document.getElementById('customizeItemName').textContent;
            var match = priceText.match(/\$(\d+(\.\d+)?)/);
            var basePrice = match ? parseFloat(match[1]) : 0;
            updateCustomizeSubtotal(basePrice);
        }

        // 與後端 OrderItem.Subtotal 相同：（品項單價 + 每份加料金額）x 份數
        function updateCustomizeSubtotal(basePrice) {
            var perServing = basePrice || 0;
            document.querySelectorAll('.addon-checkbox:checked').forEach(function (cb) {
                var price = parseFloat(cb.dataset.addonPrice) || 0;
                var qtyInput = cb.closest('.addon-row').querySelector('.addon-qty-input');
                var qty = parseInt(qtyInput.value || '1', 10);
                perServing += price * qty;
            });
            var servings = parseInt(document.getElementById('customizeQuantity').value || '1', 10) || 1;
            document.getElementById('customizeSubtotal').textContent = (perServing * servings).toFixed(0);
        }

        // 客製化面板「加入清單」：設定（辣度、加料、備註）完全相同的合併份數，否則另起一列
        // 客製化表單僅在訂單未結帳且有上架品項時才會輸出，需先判斷避免 null 錯誤中斷後續腳本
        var customizeForm = document.getElementById('customizeForm');
        if (customizeForm) customizeForm.addEventListener('submit', function (event) {
            event.preventDefault();
            var form = event.target;
            var card = document.querySelector('.menu-item-card[data-id="' + document.getElementById('customizeMenuItemId').value + '"]');
            var spiceInput = form.querySelector('input[name="SpiceLevel"]:checked');
            var addOns = [];
            if (card.dataset.supportsAddons === 'true') {
                form.querySelectorAll('.addon-checkbox:checked').forEach(function (cb) {
                    addOns.push({
                        id: parseInt(cb.dataset.addonId, 10), name: cb.dataset.addonName, price: parseFloat(cb.dataset.addonPrice),
                        qty: parseInt(cb.closest('.addon-row').querySelector('.addon-qty-input').value || '1', 10)
                    });
                });
            }
            var line = {
                menuItemId: parseInt(card.dataset.id, 10), name: card.dataset.name, price: parseFloat(card.dataset.price),
                customized: true,
                quantity: parseInt(document.getElementById('customizeQuantity').value || '1', 10),
                note: form.elements['Note'].value.trim(),
                spiceLevel: card.dataset.supportsSpice === 'true' && spiceInput ? parseInt(spiceInput.value, 10) : null,
                addOns: addOns
            };
            var settings = function (l) { return JSON.stringify([l.menuItemId, l.note, l.spiceLevel, l.addOns.map(function (a) { return [a.id, a.qty]; })]); };
            var same = cart.find(function (l) { return l.customized && settings(l) === settings(line); });
            if (same) {
                changeQuantity(same, line.quantity);
            } else {
                cart.push(line);
                renderCart();
            }
            bootstrap.Offcanvas.getOrCreateInstance(document.getElementById('customizeItemPanel')).hide();
        });

        // 送出：把清單轉成 Items[i].xxx 欄位，由後端 AddItems 一次寫入
        if (cartForm) cartForm.addEventListener('submit', function (event) {
            if (cart.length === 0 || document.getElementById('cartSubmit').disabled) {
                event.preventDefault();
                return;
            }
            cartForm.querySelectorAll('input[data-generated-item]').forEach(function (el) { el.remove(); });
            function addField(name, value) {
                var hidden = document.createElement('input');
                hidden.type = 'hidden';
                hidden.name = name;
                hidden.value = value;
                hidden.setAttribute('data-generated-item', 'true');
                cartForm.appendChild(hidden);
            }
            cart.forEach(function (line, i) {
                var prefix = 'Items[' + i + '].';
                addField(prefix + 'MenuItemId', line.menuItemId);
                addField(prefix + 'Quantity', line.quantity);
                addField(prefix + 'Note', line.note.trim());
                if (line.spiceLevel !== null) {
                    addField(prefix + 'SpiceLevel', line.spiceLevel);
                }
                line.addOns.forEach(function (a, j) {
                    addField(prefix + 'AddOns[' + j + '].AddOnId', a.id);
                    addField(prefix + 'AddOns[' + j + '].Quantity', a.qty);
                });
            });
            cartSubmitting = true;
        });

        // 送出即出單（v14）：AddItems 成功後導回本頁並帶自動出單標記，直接送出「確認訂單」開啟 PassPRNT
        // 標記存在 TempData、讀一次即消失，重新整理不會再出一次；手機不會輸出此表單
        var confirmPrintForm = document.getElementById('confirmPrintForm');
        if (confirmPrintForm && confirmPrintForm.dataset.autoPrint === 'true') {
            var confirmPrintButton = confirmPrintForm.querySelector('button[type="submit"]');
            confirmPrintButton.disabled = true;
            confirmPrintButton.textContent = '出單中...';
            confirmPrintForm.submit();
        }

        // 清單有內容時離開頁面的提醒：
        // 站內連結與其他表單（確認訂單、移除品項等）用 confirm 詢問，iPad Safari 也有效；
        // 重新整理、關閉分頁則靠 beforeunload（iPad Safari 不一定會跳出，屬瀏覽器限制）
        var leaveMessage = '本次點餐清單尚未送出，離開後清單會消失。確定要離開？';
        document.addEventListener('click', function (event) {
            var link = event.target.closest('a[href]');
            if (link && cart.length > 0 && !link.getAttribute('href').startsWith('#') && !confirm(leaveMessage)) {
                event.preventDefault();
            }
        }, true);
        // 捕獲階段先執行，取消時其他表單的 onsubmit 與下方的防連點都不會觸發
        document.addEventListener('submit', function (event) {
            if (event.target !== cartForm && event.target !== customizeForm && cart.length > 0 && !confirm(leaveMessage)) {
                event.preventDefault();
                event.stopImmediatePropagation();
            }
        }, true);
        window.addEventListener('beforeunload', function (event) {
            if (cart.length > 0 && !cartSubmitting) {
                event.preventDefault();
                event.returnValue = '';
            }
        });

        // 防止網路較慢時使用者重複點擊送出，造成同一動作被送出兩次（例如重複加點）
        document.querySelectorAll('form').forEach(function (form) {
            form.addEventListener('submit', function (event) {
                if (event.defaultPrevented) {
                    return;
                }
                var submitBtn = form.querySelector('button[type="submit"]');
                if (submitBtn && !submitBtn.disabled) {
                    submitBtn.disabled = true;
                    submitBtn.textContent = '處理中...';
                }
            });
        });
    </script>
}

