@model ManTingEats.Models.ReservationSearchViewModel
@{
    ViewData["Title"] = "訂位記錄";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h1 class="mb-0">訂位記錄</h1>
    <a asp-action="Create" class="btn btn-primary">+ 新增訂位</a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label">姓名</label>
                <input type="text" name="customerName" value="@Model.CustomerName" class="form-control" placeholder="搜尋姓名" />
            </div>
            <div class="col-auto">
                <label class="form-label">日期</label>
                <input type="date" name="date" value="@Model.Date?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">查詢</button>
                <a asp-action="Index" class="btn btn-outline-secondary">清除</a>
            </div>
        </form>
    </div>
</div>

@if (Model.UpcomingOnly)
{
    <p class="text-muted">目前顯示今天以後的訂位；查詢過去的訂位請輸入姓名或選擇日期。</p>
}

@if (Model.Results.TotalCount == 0)
{
    <p class="text-muted">查無訂位記錄。</p>
}
else
{
    <div class="card">
        <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>姓名</th>
                    <th>電話</th>
                    <th class="text-end">人數</th>
                    <th>訂位時段</th>
                    <th class="text-end">操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var reservation in Model.Results.Items)
                {
                    <tr>
                        <td>@reservation.CustomerName</td>
                        <td>@reservation.PhoneNumber</td>
                        <td class="text-end">@reservation.PartySize</td>
                        <td>@reservation.ReservedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@reservation.Id" class="btn btn-sm btn-outline-secondary">編輯</a>
                            <form asp-action="Delete" asp-route-id="@reservation.Id" method="post" class="d-inline" onsubmit="return confirm('確定要刪除此筆訂位？此操作無法復原。');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">刪除</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>
    <partial name="_Pagination" model="Model.Results" />
}
