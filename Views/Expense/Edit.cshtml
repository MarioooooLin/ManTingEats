@model ManTingEats.Models.Commands.UpdateExpenseCommand
@using ManTingEats.Models.Enums
@using ManTingEats.Models.Extensions
@{
    ViewData["Title"] = "編輯支出";
}

<div class="page-header">
    <h1>編輯支出</h1>
</div>

<div class="row">
    <div class="col-md-5">
        <div class="card">
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="Date" class="form-label"></label>
                        <input asp-for="Date" class="form-control" type="date" autofocus />
                        <span asp-validation-for="Date" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Category" class="form-label"></label>
                        <select asp-for="Category" class="form-select">
                            @foreach (var value in Enum.GetValues<ExpenseCategory>())
                            {
                                <option value="@value">@value.ToDisplayText()</option>
                            }
                        </select>
                        <span asp-validation-for="Category" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Amount" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Amount" asp-format="{0:F0}" class="form-control" type="number" step="1" inputmode="numeric" data-msg-step="金額需為整數" />
                        </div>
                        <span asp-validation-for="Amount" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Note" class="form-label"></label>
                        <input asp-for="Note" class="form-control" />
                        <span asp-validation-for="Note" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">儲存</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">取消</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
