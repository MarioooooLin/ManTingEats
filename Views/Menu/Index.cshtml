@model List<ManTingEats.Models.Entities.MenuItem>
@{
    ViewData["Title"] = "菜單管理";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h1 class="mb-0">菜單管理</h1>
    <a asp-action="Create" class="btn btn-primary">+ 新增品項</a>
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">尚無菜單品項，請先新增。</p>
}
else
{
    <div class="card">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>分類</th>
                    <th>名稱</th>
                    <th class="text-end">售價</th>
                    <th>狀態</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Category</td>
                        <td>@item.Name</td>
                        <td class="text-end">$@item.Price.ToString("F2")</td>
                        <td>
                            <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                                @(item.IsActive ? "上架中" : "已下架")
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">編輯</a>
                            <form asp-action="ToggleActive" asp-route-id="@item.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-warning">
                                    @(item.IsActive ? "下架" : "上架")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
