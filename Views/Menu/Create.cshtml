@model ManTingEats.Models.Commands.CreateMenuItemCommand
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "新增菜單品項";
    var categoryOptions = Enum.GetValues<MenuCategory>()
        .Select(c => new SelectListItem(c.ToDisplayText(), c.ToString()));
}

<div class="page-header">
    <h1>新增菜單品項</h1>
</div>

<div class="row">
    <div class="col-md-5">
        <div class="card">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" autofocus />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Category" class="form-label"></label>
                        <select asp-for="Category" asp-items="categoryOptions" class="form-select"></select>
                        <span asp-validation-for="Category" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Price" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Price" class="form-control" type="number" step="1" inputmode="numeric" data-msg-step="金額需為整數" />
                        </div>
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                    <div class="customization-card mb-3">
                        <div class="fw-bold mb-2">客製化設定</div>
                        <div class="form-check form-switch mb-2">
                            <input asp-for="SupportsAddOns" class="form-check-input" role="switch" />
                            <label asp-for="SupportsAddOns" class="form-check-label">開放加料</label>
                        </div>
                        <div class="form-check form-switch mb-2">
                            <input asp-for="SupportsSpiceLevel" class="form-check-input" role="switch" />
                            <label asp-for="SupportsSpiceLevel" class="form-check-label">開放調整辣度</label>
                        </div>
                        <div class="small text-muted">ℹ️ 開啟後，點餐時將顯示對應的客製化表單</div>
                    </div>
                    <button type="submit" class="btn btn-primary">儲存</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">取消</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
