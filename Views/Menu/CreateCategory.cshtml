@model ManTingEats.Models.Commands.CreateMenuCategoryCommand
@{
    ViewData["Title"] = "新增分類";
}

<div class="page-header">
    <h1>新增分類</h1>
</div>

<div class="row">
    <div class="col-md-5">
        <div class="card">
            <div class="card-body">
                <form asp-action="CreateCategory" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" autofocus />
                        <span asp-validation-for="Name" class="text-danger"></span>
                        <div class="form-text">新分類排在最後，可在分類列表上移調整順序。</div>
                    </div>
                    <button type="submit" class="btn btn-primary">儲存</button>
                    <a asp-action="Index" asp-fragment="categories" class="btn btn-outline-secondary">取消</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
