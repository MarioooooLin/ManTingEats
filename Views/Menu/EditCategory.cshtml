@model ManTingEats.Models.Commands.UpdateMenuCategoryCommand
@{
    ViewData["Title"] = "編輯分類";
}

<div class="page-header">
    <h1>編輯分類</h1>
</div>

<div class="row">
    <div class="col-md-5">
        <div class="card">
            <div class="card-body">
                <form asp-action="EditCategory" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" autofocus />
                        <span asp-validation-for="Name" class="text-danger"></span>
                        <div class="form-text">改名後，點餐頁的分類分頁與此分類下的所有品項一併更新。</div>
                    </div>
                    <button type="submit" class="btn btn-primary">儲存</button>
                    <a asp-action="Index" asp-fragment="categories" class="btn btn-outline-secondary">取消</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
