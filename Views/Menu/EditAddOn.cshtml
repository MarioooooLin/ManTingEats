@model ManTingEats.Models.Commands.UpdateAddOnCommand
@{
    ViewData["Title"] = "編輯加料";
}

<div class="page-header">
    <h1>編輯加料</h1>
</div>

<div class="row">
    <div class="col-md-5">
        <div class="card">
            <div class="card-body">
                <form asp-action="EditAddOn" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" autofocus />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Price" class="form-label">加價</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Price" class="form-control" type="number" step="1" inputmode="numeric" data-msg-step="金額需為整數" />
                        </div>
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">儲存</button>
                    <a asp-action="Index" asp-fragment="addons" class="btn btn-outline-secondary">取消</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
