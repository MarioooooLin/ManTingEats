@model ManTingEats.Models.IPagination
@{
    var request = Context.Request;
    // 換頁時保留目前的查詢條件（日期、分類等），只替換 page 參數
    string PageUrl(int page)
    {
        var query = request.Query
            .Where(q => !string.Equals(q.Key, "page", StringComparison.OrdinalIgnoreCase))
            .SelectMany(q => q.Value.Select(v => $"{Uri.EscapeDataString(q.Key)}={Uri.EscapeDataString(v ?? string.Empty)}"))
            .Append($"page={page}");
        return $"{request.Path}?{string.Join("&", query)}";
    }

    // 只顯示目前頁前後各 2 頁，頁數多時導覽列不會過長
    var firstShown = Math.Max(1, Model.Page - 2);
    var lastShown = Math.Min(Model.TotalPages, Model.Page + 2);
}

@if (Model.TotalPages > 1)
{
    <nav class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3" aria-label="分頁">
        <span class="text-muted">共 @Model.TotalCount 筆，第 @Model.Page / @Model.TotalPages 頁</span>
        <ul class="pagination mb-0">
            <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                <a class="page-link" href="@PageUrl(Model.Page - 1)">上一頁</a>
            </li>
            @if (firstShown > 1)
            {
                <li class="page-item"><a class="page-link" href="@PageUrl(1)">1</a></li>
                if (firstShown > 2)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
            }
            @for (var pageNumber = firstShown; pageNumber <= lastShown; pageNumber++)
            {
                <li class="page-item @(pageNumber == Model.Page ? "active" : "")">
                    <a class="page-link" href="@PageUrl(pageNumber)">@pageNumber</a>
                </li>
            }
            @if (lastShown < Model.TotalPages)
            {
                if (lastShown < Model.TotalPages - 1)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
                <li class="page-item"><a class="page-link" href="@PageUrl(Model.TotalPages)">@Model.TotalPages</a></li>
            }
            <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="@PageUrl(Model.Page + 1)">下一頁</a>
            </li>
        </ul>
    </nav>
}
