@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    // 只是隱藏連結；權限實際由各 Controller 的 [Authorize(Roles = AppRoles.Manager)] 把關
    var isManager = User.IsInRole(AppRoles.Manager);
}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ManTingEats</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/flatpickr/dist/flatpickr.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ManTingEats.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">🐶🐱 ManTingEats</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark @(currentController == "Home" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">首頁</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark @(currentController == "Order" ? "active" : "")" asp-area="" asp-controller="Order" asp-action="Index">訂單</a>
                            </li>
                            @if (isManager)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark @(currentController == "Menu" ? "active" : "")" asp-area="" asp-controller="Menu" asp-action="Index">菜單管理</a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link text-dark @(currentController == "Reservation" ? "active" : "")" asp-area="" asp-controller="Reservation" asp-action="Index">訂位記錄</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark @(currentController == "DailyClosing" ? "active" : "")" asp-area="" asp-controller="DailyClosing" asp-action="Index">日結</a>
                            </li>
                            @if (isManager)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark @(currentController == "Expense" ? "active" : "")" asp-area="" asp-controller="Expense" asp-action="Index">支出記錄</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark @(currentController == "Report" ? "active" : "")" asp-area="" asp-controller="Report" asp-action="Index">營收報表</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark @(currentController == "Employee" ? "active" : "")" asp-area="" asp-controller="Employee" asp-action="Index">帳號管理</a>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item d-flex align-items-center me-2">
                                <span class="user-chip">@User.Identity.Name</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-link nav-link text-dark">登出</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">登入</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            <partial name="_StatusMessage" />
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - ManTingEats - <a asp-area="" asp-controller="Home" asp-action="Privacy">隱私權政策</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/flatpickr/dist/flatpickr.min.js"></script>
    <script src="~/lib/flatpickr/dist/l10n/zh-tw.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
