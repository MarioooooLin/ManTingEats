@model ErrorViewModel
@{
    ViewData["Title"] = "錯誤";
}

<h1 class="text-danger">發生錯誤</h1>
<h2 class="text-danger">處理您的請求時發生錯誤。</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>要求識別碼：</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>開發模式</h3>
<p>
    切換至<strong>開發（Development）</strong>環境將顯示更詳細的錯誤資訊。
</p>
<p>
    <strong>正式上線環境不應啟用開發環境。</strong>
    這可能導致將例外狀況中的敏感資訊顯示給使用者。
    如需在本機除錯，請將環境變數 <strong>ASPNETCORE_ENVIRONMENT</strong> 設定為 <strong>Development</strong> 後重新啟動應用程式。
</p>
